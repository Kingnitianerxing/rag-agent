# --- LLM Configuration ----------------------------------
LLM_PROVIDER=openai                    # Supported: openai, anthropic
LLM_MODEL=gpt-4o
LLM_API_KEY=sk-xxx                     # Get from https://platform.openai.com/api-keys
# LLM_BASE_URL=                        # Optional: custom endpoint (OpenAI-compat needs .../v1)
# LLM model routing: cheap model for the agent's control-plane calls (route/grade/rewrite),
# strong model (LLM_MODEL) for generation; same-provider fallback on error/timeout.
LLM_MODEL_FAST=gpt-4o-mini
LLM_FALLBACK_MODEL=gpt-4o-mini
LLM_TIMEOUT=30

# --- Embedding Configuration ----------------------------
EMBEDDING_PROVIDER=openai              # Supported: openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=sk-xxx
# EMBEDDING_BASE_URL=                  # Optional

# --- Multimodal image embeddings (DashScope, dual-track) -
# Text docs keep EMBEDDING_*; images use qwen3-vl-embedding via DashScope SDK.
DASHSCOPE_API_KEY=                     # https://help.aliyun.com/zh/model-studio/get-api-key
VL_EMBEDDING_MODEL=qwen3-vl-embedding
VL_EMBEDDING_DIMENSION=1024
VL_COLLECTION_NAME=rag_images
VL_CAPTION_MODEL=qwen-vl-plus           # vision LLM caption stored as grounded context
IMAGE_RETRIEVAL_ENABLED=false          # true = accept image upload + search rag_images

# --- Reranker Configuration -----------------------------
RERANKER_PROVIDER=cohere               # Supported: cohere, none
RERANKER_MODEL=rerank-v3.5
COHERE_API_KEY=xxx                     # Get from https://dashboard.cohere.com/

# --- Graph Extraction -----------------------------------
GRAPH_EXTRACTOR=llm                    # Supported: llm, nlp, none

# --- Qdrant Vector Database -----------------------------
QDRANT_URL=http://localhost:6333       # Use 'qdrant' hostname inside Docker
COLLECTION_NAME=rag_docs
# QDRANT_API_KEY=                      # Optional: for authenticated instances

# --- Keyword backend ------------------------------------
KEYWORD_BACKEND=local                  # local (rank_bm25, zero-dep) | opensearch (incremental, shared)
OPENSEARCH_URL=http://localhost:9200   # Use 'opensearch' hostname inside Docker
OPENSEARCH_INDEX=rag_chunks            # scale corpus: rag_chunks_scale30

# --- LangSmith Observability ----------------------------
LANGSMITH_API_KEY=xxx                  # Get from https://smith.langchain.com/
LANGSMITH_PROJECT=production-rag
LANGSMITH_TRACING=true

# --- Generation -----------------------------------------
PROMPT_MODE=grounded                   # grounded (cite + refuse) | basic (legacy, for A/B)
AGENT_MAX_REWRITES=2                    # /agent corrective-RAG max query rewrites

# --- Cache ----------------------------------------------
CACHE_ENABLED=false                    # true = skip retrieval+generation on repeated/similar queries
CACHE_SIMILARITY_THRESHOLD=0.95        # cosine threshold for a semantic cache hit (0.0-1.0)
REDIS_URL=                             # e.g. redis://localhost:6379/0; empty = in-process cache

# --- Chat history (multi-turn) --------------------------
HISTORY_CONDENSE_ENABLED=true          # rewrite follow-ups into standalone questions (fast model)
CHAT_HISTORY_MAX_TURNS=10              # last N turns kept server-side
CHAT_HISTORY_MAX_TURN_CHARS=2000       # per-turn content cap

# --- Chunking Strategy ----------------------------------
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# --- Retrieval Settings ---------------------------------
RETRIEVAL_MODE=hybrid                  # hybrid (vector + BM25 RRF) | dense (vector only)
QUERY_TRANSFORM=none                   # none | multi_query (paraphrase + fuse) | hyde
TOP_K=5
RERANK_TOP_K=5

# --- Storage --------------------------------------------
DATA_DIR=./data

# --- Security / Auth ------------------------------------
# SHA256 hash of a shared service bearer token (optional; maps to full-access service role)
API_KEY_HASH=
# JWT user auth + document ACL (set AUTH_ENABLED=true in production)
AUTH_ENABLED=false
JWT_SECRET=                            # required for /auth/login when using JWT
JWT_EXPIRE_MINUTES=1440
BOOTSTRAP_ADMIN_USERNAME=              # created on first boot if both set
BOOTSTRAP_ADMIN_PASSWORD=
# Comma-separated allowed origins for the browser SPA. Use "*" only for a public, auth-off demo.
# Vite dev server runs on http://localhost:5173. In production set this to your deployed SPA origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_FILE_SIZE_MB=100                   # Max file size for ingestion (MB)

# --- Guardrails -----------------------------------------
GUARDRAILS_ENABLED=true                 # input injection block + output PII redaction + toxicity flag

# --- MCP server -----------------------------------------
MCP_ALLOW_INGEST=true                   # expose the ingest (write) tool over MCP
